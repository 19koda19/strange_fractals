{
  "name": "noema-strange-fractals",
  "version": "1.0.0",
  "private": true,
  "description": "A seed-phrase strange-attractor instrument for p5.js, WebGL2, and Electron.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "p5": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^43.3.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
